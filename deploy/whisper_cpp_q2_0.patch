+void ggml_vec_dot_q2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_q2_0 * GGML_RESTRICT x = vx;
+    const block_q8_0 * GGML_RESTRICT y = vy;
+
+    const int nb = n / QK2_0;
+
+#if defined(__AVX2__)
+    __m256 sumf = _mm256_setzero_ps();
+
+    const __m128i m3   = _mm_set1_epi8(3);
+    const __m256i ones8  = _mm256_set1_epi8(1);
+    const __m256i ones16 = _mm256_set1_epi16(1);
+
+    for (int i = 0; i < nb; ++i) {
+        // 16 байт = 64 веса, лента: байт b несёт веса 4b+l в битах 2l
+        const __m128i q = _mm_loadu_si128((const __m128i *) x[i].qs);
+
+        __m128i v0 = _mm_and_si128(q, m3);
+        __m128i v1 = _mm_and_si128(_mm_srli_epi16(q, 2), m3);
+        __m128i v2 = _mm_and_si128(_mm_srli_epi16(q, 4), m3);
+        __m128i v3 = _mm_and_si128(_mm_srli_epi16(q, 6), m3);
+
+        // расплетаем в естественный порядок весов w0..w63
+        const __m128i ab_lo = _mm_unpacklo_epi8(v0, v1);
+        const __m128i cd_lo = _mm_unpacklo_epi8(v2, v3);
+        const __m128i ab_hi = _mm_unpackhi_epi8(v0, v1);
+        const __m128i cd_hi = _mm_unpackhi_epi8(v2, v3);
+
+        const __m128i w00_15 = _mm_unpacklo_epi16(ab_lo, cd_lo);
+        const __m128i w16_31 = _mm_unpackhi_epi16(ab_lo, cd_lo);
+        const __m128i w32_47 = _mm_unpacklo_epi16(ab_hi, cd_hi);
+        const __m128i w48_63 = _mm_unpackhi_epi16(ab_hi, cd_hi);
+
+        const __m256i q0 = _mm256_set_m128i(w16_31, w00_15);   // коды {0,1,2}, веса 0..31
+        const __m256i q1 = _mm256_set_m128i(w48_63, w32_47);   // веса 32..63
+
+        const __m256i qy0 = _mm256_loadu_si256((const __m256i *) y[2*i + 0].qs);
+        const __m256i qy1 = _mm256_loadu_si256((const __m256i *) y[2*i + 1].qs);
+
+        // (код-1)*y == код*y - y;  maddubs: беззнаковые коды на знаковые y
+        __m256i p0 = _mm256_sub_epi16(_mm256_maddubs_epi16(q0, qy0),
+                                      _mm256_maddubs_epi16(ones8, qy0));
+        __m256i p1 = _mm256_sub_epi16(_mm256_maddubs_epi16(q1, qy1),
+                                      _mm256_maddubs_epi16(ones8, qy1));
+
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+        const __m256 g0 = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2*i + 0].d));
+        const __m256 g1 = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(y[2*i + 1].d));
+
+        sumf = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_madd_epi16(p0, ones16)), g0, sumf);
+        sumf = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_madd_epi16(p1, ones16)), g1, sumf);
+    }
+
+    *s = hsum_float_8(sumf);
+
+#else
+    UNUSED(x);
+    UNUSED(y);
+    UNUSED(nb);
+    ggml_vec_dot_q2_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
